# CareFlow AI — example environment. Synthetic demo only. Never commit real credentials.
# OWNER / migration role (SUPERUSER or BYPASSRLS). Used by db:migrate, db:seed, db:reset and the
# demo-reset purge path only — never for request traffic or jobs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/careflow
# Least-privilege APP role used by the web app for every request and by `pnpm jobs` (RLS forced; no
# BYPASSRLS, owns nothing; jobs run once per organization with the tenant set).
# `pnpm db:migrate` creates `careflow_app` and sets its LOGIN password from this URL.
# DEV-ONLY PASSWORD — change it in any shared deployment.
APP_DATABASE_URL=postgres://careflow_app:careflow_app_dev_only@localhost:5432/careflow
# Integration tests use a separate database that they truncate/reseed (owner + app role; same role password).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/careflow_test
TEST_APP_DATABASE_URL=postgres://careflow_app:careflow_app_dev_only@localhost:5432/careflow_test
# Demo reset (Settings → Reset demo) uses DATABASE_URL from the web process. Set to false in any
# non-demo deployment (and do not give the web app DATABASE_URL at all).
# DEMO_RESET_ENABLED=false

# Per-account sign-in lockout (defaults shown): N consecutive failures within the window lock that email
# for the cool-down, regardless of source IP. Deployment-wide (sign-in happens before the tenant is known).
# LOGIN_LOCKOUT_MAX_FAILURES=5
# LOGIN_LOCKOUT_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_SECONDS=900

# HMAC salt for stable, non-reversible experiment assignment. Change in any shared deployment.
EXPERIMENT_HMAC_SALT=dev-only-change-me-experiment-salt

# Optional: fixed seed anchor (YYYY-MM-DD) for byte-identical demo resets. Defaults to today (UTC).
# SEED_ANCHOR_DATE=2026-10-19

# Optional public data refresh (US Census ACS 2024 5-year). Demo works without it.
# CENSUS_API_KEY=
# Comma-separated real ZCTAs to fetch into the provenance table (fixture map is unaffected).
# ACS_ZCTAS=92618,92620

# Optional AI narrative drafting. Disabled by default; deterministic templates are used offline.
LLM_ENABLED=false
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
