{
  "name": "@careflow/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./schema": "./src/schema.ts" },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/seed.ts --reset",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@careflow/connectors": "workspace:*",
    "@careflow/core": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": { "drizzle-kit": "^0.31.8", "tsx": "^4.19.2", "vitest": "^3.2.4", "@types/node": "^22.10.2" }
}
